	if n.RawKind == "sing-box" && n.Raw != nil {
		m := cloneMap(n.Raw)
		m["tag"] = tag
		return m, nil
	}
	if n.RawKind == "xray" {
		return nil, errors.New("Xray-only JSON node cannot be used by sing-box")
	}
	p := n.Proxy
	if p == nil {
		return nil, errors.New("empty node")
	}
	typ := strings.ToLower(stringValue(p["type"]))
	server := stringValue(p["server"])
	port := intValue(p["port"])
	if server == "" || port == 0 {
		return nil, errors.New("server/port missing")
	}
	m := map[string]interface{}{"type": typ, "tag": tag, "server": server, "server_port": port}
	switch typ {
	case "vless":
		m["uuid"] = stringValue(p["uuid"])
		if flow := stringValue(p["flow"]); flow != "" { m["flow"] = flow }
		applySingBoxTLS(m, p, true); applySingBoxTransport(m, p)
	case "vmess":
		m["uuid"] = stringValue(p["uuid"]); m["security"] = "auto"
		if aid := intValue(p["alterId"]); aid != 0 { m["alter_id"] = aid }
		applySingBoxTLS(m, p, false); applySingBoxTransport(m, p)
	case "trojan":
		m["password"] = stringValue(p["password"]); applySingBoxTLS(m, p, true); applySingBoxTransport(m, p)
	case "hysteria2":
		m["password"] = stringValue(p["password"]); applySingBoxTLS(m, p, true)
		if obfs := stringValue(p["obfs"]); obfs != "" { ob := map[string]interface{}{"type": obfs}; if pass := stringValue(p["obfs-password"]); pass != "" { ob["password"] = pass }; m["obfs"] = ob }
		if up := bandwidthMbps(p["up"]); up > 0 { m["up_mbps"] = up }; if down := bandwidthMbps(p["down"]); down > 0 { m["down_mbps"] = down }
	case "ss":
		m["type"] = "shadowsocks"; m["method"] = stringValue(p["cipher"]); m["password"] = stringValue(p["password"])
	case "socks5", "socks":
		m["type"] = "socks"; m["version"] = "5"; if v := stringValue(p["username"]); v != "" { m["username"] = v }; if v := stringValue(p["password"]); v != "" { m["password"] = v }
	default:
		return nil, fmt.Errorf("protocol %s is not supported by sing-box generator", typ)
	}
	return m, nil
}

func bandwidthMbps(v interface{}) int { s := strings.ToLower(strings.TrimSpace(stringValue(v))); if s == "" { return 0 }; s = strings.TrimSuffix(strings.TrimSuffix(strings.TrimSuffix(s, "mbps"), "mb"), "m"); n, _ := strconv.Atoi(strings.TrimSpace(s)); return n }

func applySingBoxTLS(m, p map[string]interface{}, force bool) {
	enabled := force || boolish(p["tls"], false) || stringValue(p["sni"]) != "" || stringValue(p["servername"]) != ""; if !enabled { return }
	t := map[string]interface{}{"enabled": true}; if sni := firstNonEmpty(stringValue(p["servername"]), stringValue(p["sni"])); sni != "" { t["server_name"] = sni }; if boolish(p["skip-cert-verify"], false) { t["insecure"] = true }; if fp := stringValue(p["client-fingerprint"]); fp != "" { t["utls"] = map[string]interface{}{"enabled": true, "fingerprint": fp} }
	if ro, ok := p["reality-opts"].(map[string]interface{}); ok { r := map[string]interface{}{"enabled": true}; if v := stringValue(ro["public-key"]); v != "" { r["public_key"] = v }; if v := stringValue(ro["short-id"]); v != "" { r["short_id"] = v }; if len(r) > 1 { t["reality"] = r } }; m["tls"] = t
}

func applySingBoxTransport(m, p map[string]interface{}) {
	network := strings.ToLower(stringValue(p["network"])); switch network {
	case "ws":
		t := map[string]interface{}{"type": "ws"}; if o, ok := p["ws-opts"].(map[string]interface{}); ok { if v := o["path"]; v != nil && stringValue(v) != "" { t["path"] = stringValue(v) }; if v := o["headers"]; v != nil { t["headers"] = v }; if v := o["max-early-data"]; v != nil { t["max_early_data"] = intValue(v) } }; m["transport"] = t
	case "grpc":
		t := map[string]interface{}{"type": "grpc"}; if o, ok := p["grpc-opts"].(map[string]interface{}); ok { if v := stringValue(o["grpc-service-name"]); v != "" { t["service_name"] = v } }; m["transport"] = t
	case "http", "h2":
		t := map[string]interface{}{"type": "http"}; if o, ok := p["http-opts"].(map[string]interface{}); ok { if v := o["path"]; v != nil { t["path"] = v }; if v := o["headers"]; v != nil { t["headers"] = v } }; m["transport"] = t
	}
}

func uniqueTag(base string, used map[string]int) string { base = strings.TrimSpace(base); if base == "" { base = "Proxy" }; used[base]++; if used[base] == 1 { return base }; return fmt.Sprintf("%s · %d", base, used[base]) }

func rebuildSingBoxConfig(dir string, st State) error {
	port, secret := readClashAPIConfig(); used := map[string]int{}; outbounds := []interface{}{map[string]interface{}{"type": "direct", "tag": "DIRECT"}}; refTags := map[string]string{}; var testTags []string; subTags := map[string][]string{}
	for _, item := range allNodes(st) { tag := uniqueTag(item.Group+" · "+item.Node.Name, used); o, err := singBoxOutboundFromNode(item.Node, tag); if err != nil { continue }; outbounds = append(outbounds, o); refTags[item.Ref] = tag; testTags = append(testTags, tag); if strings.HasPrefix(item.Ref, "sub:") { parts := strings.SplitN(strings.TrimPrefix(item.Ref, "sub:"), ":", 2); if len(parts) == 2 { subTags[parts[0]] = append(subTags[parts[0]], tag) } } }
	var chainTags []string
	for _, ch := range st.Chains { if !ch.Enabled || len(ch.Hops) < 2 { continue }; prev := ""; ok := true; for i, ref := range ch.Hops { n, exists := resolveNodeRef(st, ref); if !exists { ok = false; break }; tag := uniqueTag(fmt.Sprintf("CHAIN · %s · %d", ch.Name, i+1), used); o, err := singBoxOutboundFromNode(n, tag); if err != nil { ok = false; break }; if prev != "" { o["detour"] = prev }; outbounds = append(outbounds, o); prev = tag }; if ok && prev != "" { refTags[chainRef(ch.ID)] = prev; chainTags = append(chainTags, prev); testTags = append(testTags, prev) } }
	selectorItems := []string{"AUTO"}; for _, sub := range st.Subscriptions { items := subTags[sub.ID]; if len(items) == 0 { continue }; g := uniqueTag("SUB · "+sub.Name, used); outbounds = append(outbounds, map[string]interface{}{"type": "selector", "tag": g, "outbounds": items, "interrupt_exist_connections": true}); selectorItems = append(selectorItems, g) }; for _, n := range st.Servers { if tag := refTags[nodeRefLocal(n.ID)]; tag != "" { selectorItems = append(selectorItems, tag) } }; selectorItems = append(selectorItems, chainTags...); selectorItems = append(selectorItems, "DIRECT"); if len(testTags) == 0 { testTags = []string{"DIRECT"} }
	outbounds = append(outbounds, map[string]interface{}{"type": "urltest", "tag": "AUTO", "outbounds": testTags, "url": "https://www.gstatic.com/generate_204", "interval": "5m", "tolerance": 50}); proxy := map[string]interface{}{"type": "selector", "tag": "PROXY", "outbounds": selectorItems, "interrupt_exist_connections": true}; if st.SelectedNode != "" && st.SelectedNode != "auto" { if t := refTags[st.SelectedNode]; t != "" { proxy["default"] = t } } else { proxy["default"] = "AUTO" }; outbounds = append(outbounds, proxy)
	rules, ruleSets := singBoxRouteRules(st); final := "PROXY"; if st.Mode == "direct" { final = "DIRECT" }
	cfg := map[string]interface{}{"log": map[string]interface{}{"level": "info", "timestamp": true}, "dns": map[string]interface{}{"servers": []interface{}{map[string]interface{}{"type": "udp", "tag": "dns-direct", "server": "1.1.1.1"}}, "final": "dns-direct", "strategy": "prefer_ipv4"}, "inbounds": []interface{}{map[string]interface{}{"type": "mixed", "tag": "mixed-in", "listen": "::", "listen_port": 7080}, map[string]interface{}{"type": "tproxy", "tag": "tproxy-in", "listen": "::", "listen_port": 1536}}, "outbounds": outbounds, "route": map[string]interface{}{"rules": rules, "rule_set": ruleSets, "find_process": true, "final": final}, "experimental": map[string]interface{}{"cache_file": map[string]interface{}{"enabled": true, "path": filepath.Join(dir, "sing-box-cache.db")}, "clash_api": map[string]interface{}{"external_controller": "127.0.0.1:" + port, "secret": secret, "default_mode": "Rule"}}}
	b, _ := json.MarshalIndent(cfg, "", "  "); target := singBoxConfigPath(); old, _ := os.ReadFile(target); if err := atomicWrite(target, append(b, '\n'), 0644); err != nil { return err }; if err := validateJSONCoreConfig("sing-box", target); err != nil { if len(old) > 0 { _ = atomicWrite(target, old, 0644) }; return fmt.Errorf("sing-box config validation failed: %w", err) }; return nil
}

func singBoxRouteRules(st State) ([]interface{}, []interface{}) {
	rules := []interface{}{map[string]interface{}{"action": "sniff"}, map[string]interface{}{"type": "logical", "mode": "or", "rules": []interface{}{map[string]interface{}{"port": 53}, map[string]interface{}{"protocol": "dns"}}, "action": "hijack-dns"}}; sets := []interface{}{}; if st.Mode != "routing" { return rules, sets }; idx := findRouting(st.Routings, st.ActiveRouting); if idx < 0 { rules = append(rules, map[string]interface{}{"ip_is_private": true, "action": "route", "outbound": "DIRECT"}); return rules, sets }; var r map[string]interface{}; if json.Unmarshal(st.Routings[idx].Raw, &r) != nil { return rules, sets }; setSeen := map[string]bool{}
	appendClass := func(siteKey, ipKey, outbound string, reject bool) {
		for _, raw := range stringSlice(firstInterface(r, siteKey, lowerFirst(siteKey))) { x := strings.TrimSpace(raw); if x == "" { continue }; lx := strings.ToLower(x); if strings.HasPrefix(lx, "geosite:") { name := strings.TrimSpace(x[len("geosite:"):]); tag := "geosite-" + safeID(name); if !setSeen[tag] { setSeen[tag] = true; sets = append(sets, map[string]interface{}{"type": "remote", "tag": tag, "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-" + url.PathEscape(name) + ".srs", "download_detour": "PROXY", "update_interval": "24h"}) }; rule := map[string]interface{}{"rule_set": []string{tag}}; if reject { rule["action"] = "reject" } else { rule["action"] = "route"; rule["outbound"] = outbound }; rules = append(rules, rule); continue }; val := strings.TrimPrefix(strings.TrimPrefix(x, "+."), "."); rule := map[string]interface{}{"domain_suffix": []string{val}}; if reject { rule["action"] = "reject" } else { rule["action"] = "route"; rule["outbound"] = outbound }; rules = append(rules, rule) }
		for _, raw := range stringSlice(firstInterface(r, ipKey, lowerFirst(ipKey))) { x := strings.TrimSpace(raw); if x == "" { continue }; lx := strings.ToLower(x); if strings.HasPrefix(lx, "geoip:") { name := strings.TrimSpace(x[len("geoip:"):]); tag := "geoip-" + safeID(name); if !setSeen[tag] { setSeen[tag] = true; sets = append(sets, map[string]interface{}{"type": "remote", "tag": tag, "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/" + url.PathEscape(name) + ".srs", "download_detour": "PROXY", "update_interval": "10d"}) }; rule := map[string]interface{}{"rule_set": []string{tag}}; if reject { rule["action"] = "reject" } else { rule["action"] = "route"; rule["outbound"] = outbound }; rules = append(rules, rule); continue }; cidr := x; if !strings.Contains(cidr, "/") { if strings.Contains(cidr, ":") { cidr += "/128" } else { cidr += "/32" } }; rule := map[string]interface{}{"ip_cidr": []string{cidr}}; if reject { rule["action"] = "reject" } else { rule["action"] = "route"; rule["outbound"] = outbound }; rules = append(rules, rule) }
	}
	order := strings.ToLower(firstString(r, "RouteOrder", "routeOrder")); if order == "" { order = "block-proxy-direct" }; seen := map[string]bool{}; for _, piece := range strings.Split(order, "-") { switch strings.TrimSpace(piece) { case "block": appendClass("BlockSites", "BlockIp", "", true); seen["block"] = true; case "proxy": appendClass("ProxySites", "ProxyIp", "PROXY", false); seen["proxy"] = true; case "direct": appendClass("DirectSites", "DirectIp", "DIRECT", false); seen["direct"] = true } }
	if !seen["block"] {
